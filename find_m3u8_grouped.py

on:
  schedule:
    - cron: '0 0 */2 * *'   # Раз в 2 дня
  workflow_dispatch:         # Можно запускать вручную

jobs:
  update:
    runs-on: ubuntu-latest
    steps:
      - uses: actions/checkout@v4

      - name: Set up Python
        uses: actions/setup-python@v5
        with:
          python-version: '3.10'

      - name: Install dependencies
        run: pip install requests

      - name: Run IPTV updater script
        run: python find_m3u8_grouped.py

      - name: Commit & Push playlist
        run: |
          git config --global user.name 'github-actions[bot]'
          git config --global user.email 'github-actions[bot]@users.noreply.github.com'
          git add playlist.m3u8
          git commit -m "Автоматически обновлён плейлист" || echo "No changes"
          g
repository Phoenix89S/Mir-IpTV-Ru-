import requests
import re

GITHUB_PLAYLISTS = [
    "https://raw.githubusercontent.com/iptv-org/iptv/master/channels/ru.m3u"
]

CHANNEL_GROUPS = {
    "НТВ": ["НТВ", "НТВ Мир", "НТВ Стиль", "НТВ Право", "НТВ Хит", "НТВ HD"],
    # Добавьте свои группы при необходимости
}

def get_links_from_m3u(url):
    try:
        resp = requests.get(url, timeout=15)
        content = resp.text
        items = re.findall(r'#EXTINF:-?\d+.*?,(.*?)\n(https?://[^\s]+\.m3u8)', content)
        return items
    except Exception as e:
        print(f"Ошибка при обработке {url}: {e}")
        return []

def define_group(channel_name):
    for group, keys in CHANNEL_GROUPS.items():
        for key in keys:
            if key.lower() in channel_name.lower():
                return group
    return "Прочее"

def main():
    channels = []
    for url in GITHUB_PLAYLISTS:
        items = get_links_from_m3u(url)
        for name, link in items:
            group = define_group(name)
            channels.append((group, name.strip(), link.strip()))

    channels.sort(key=lambda x: (x[0], x[1]))

    with open("playlist.m3u8", "w", encoding="utf-8") as f:
        f.write("#EXTM3U\n")
        for group, name, link in channels:
            f.write(f'#EXTINF:-1 group-title="{group}",{name}\n{link}\n')
    print(f"Всего каналов: {len(channels)}")

if __name__ == "__main__":
    main()